# Database (Neon Postgres — pooled connection for the app runtime)
DATABASE_URL="postgresql://user:password@localhost:5432/booking_platform?schema=public"
# Neon direct/unpooled connection, used by Prisma Migrate (bypasses PgBouncer).
# Locally this can be identical to DATABASE_URL; on Neon it's the non "-pooler" host.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/booking_platform?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloudinary (Phase 3 — listing image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Square (sandbox credentials first — see docs/setup/environment-variables.md)
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# "sandbox" (default if unset) or "production" — must match which of the
# access token/location ID above you're using.
SQUARE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"

# Payments feature flag — "stub" (default) or "square"
PAYMENTS_PROVIDER="stub"

# Notifications (Phase 10) — email feature flag: "stub" (default, no real email sent) or "resend"
NOTIFICATIONS_PROVIDER="stub"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Maintenance mode — set to "true" in Vercel's Environment Variables and
# redeploy to take the site offline for every visitor (shows a simple
# "we'll be right back" page instead). Set back to "false" (or remove) and
# redeploy to restore normal access. Free alternative to Vercel's paid
# Deployment Protection. Leave unset/"false" for normal operation.
MAINTENANCE_MODE="false"
